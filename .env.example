CROSSSHIELD_ENV=development
CROSSSHIELD_THRESHOLD_MEDIUM=0.3
CROSSSHIELD_THRESHOLD_HIGH=0.6
CROSSSHIELD_THRESHOLD_CRITICAL=0.85
CROSSSHIELD_LOG_RAW_PROMPTS=false

# Phase 5: semantic jailbreak detection (all BASELINE/placeholder values,
# see README "Phase 5" for what each one means and why)
CROSSSHIELD_SEMANTIC_ENABLED=false
CROSSSHIELD_SEMANTIC_MODEL_NAME=sentence-transformers/LaBSE
CROSSSHIELD_SEMANTIC_DEVICE=cpu
CROSSSHIELD_SEMANTIC_LOCAL_FILES_ONLY=false
CROSSSHIELD_SEMANTIC_TEXT_PREFIX=
CROSSSHIELD_SEMANTIC_THRESHOLD=0.70
CROSSSHIELD_SEMANTIC_HARD_NEGATIVE_MARGIN=0.0
CROSSSHIELD_SEMANTIC_MAX_SEGMENTS=32
CROSSSHIELD_SEMANTIC_TOP_MATCHES=3
CROSSSHIELD_SEMANTIC_REFERENCE_PATH=
CROSSSHIELD_SEMANTIC_HARD_NEGATIVE_PATH=
CROSSSHIELD_RULE_JAILBREAK_WEIGHT=0.5
CROSSSHIELD_SEMANTIC_JAILBREAK_WEIGHT=0.5

# Phase 6: cross-lingual semantic safety analysis (BASELINE/placeholder
# values; only attempted when CROSSSHIELD_SEMANTIC_ENABLED is also true,
# since it reuses Phase 5's loaded embedder -- see README "Phase 6")
CROSSSHIELD_CROSS_LINGUAL_ENABLED=false
CROSSSHIELD_CROSS_LINGUAL_THRESHOLD=0.70
CROSSSHIELD_CROSS_LINGUAL_MARGIN=0.0
CROSSSHIELD_CROSS_LINGUAL_MAX_SEGMENTS=32
CROSSSHIELD_CROSS_LINGUAL_TOP_MATCHES=3
CROSSSHIELD_CROSS_LINGUAL_REFERENCE_PATH=

# Phase 7: context/reasoning analysis (pure local deterministic logic, no
# model, defaults to true -- see README "Phase 7")
CROSSSHIELD_CONTEXT_REASONING_ENABLED=true

# Phase 8: risk engine refinement
# Initial engineering defaults; not empirically optimized.
CROSSSHIELD_WEIGHT_PROMPT_RISK=0.35
CROSSSHIELD_WEIGHT_JAILBREAK_RISK=0.35
CROSSSHIELD_WEIGHT_CROSS_LINGUAL_RISK=0.15
CROSSSHIELD_WEIGHT_CONTEXT_RISK=0.15
# false preserves Phase 5/6 HTTP 503 behavior when the semantic model is unavailable.
# true enables explicit degraded mode with available-weight renormalization.
CROSSSHIELD_RISK_DEGRADED_MODE_ENABLED=false
